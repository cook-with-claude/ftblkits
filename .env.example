NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
NEXT_PUBLIC_WHATSAPP_NUMBER=9613000000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Admin ( /admin ) — server-only secrets, never prefix with NEXT_PUBLIC ---
# Service role key from Supabase: Project Settings > API > service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=
# Strong, unique shared password managers type to log into /admin (16+ characters recommended)
ADMIN_PASSWORD=
# Random secret used to sign the admin session cookie (at least 32 random bytes)
ADMIN_SESSION_SECRET=
